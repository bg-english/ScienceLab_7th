rules_version = '2';

// Firestore security rules for SciLab
//   - Students sign in anonymously -> each has a stable uid on their device.
//   - Students can read the whole scores collection (class leaderboard) but
//     read/write details only on their OWN score document (uid = doc id).
//   - Only the teacher (uid listed in /admins) can read everything.
// To promote your teacher account:
//   1) Sign in to the teacher dashboard once (it uses Anonymous auth) OR
//   2) In Firebase Console -> Firestore -> add a doc in /admins with id = your uid.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(doc) {
      return request.auth != null && request.auth.uid == doc.id;
    }

    // Admin registry (teacher only manages it)
    match /admins/{uid} {
      allow read: if isTeacher();
      allow write: if isTeacher();
    }

    // Sections registry: teacher-only. Students look themselves up
    // through the studentLogin callable function (server-side), so they
    // never need direct access to this collection.
    match /sections/{id} {
      allow read, write: if isTeacher();
    }

    // Students registry: teacher-only (names + access PINs).
    match /students/{id} {
      allow read, write: if isTeacher();
    }

    // Student scores: leaderboard list is shared; writes are own doc only
    match /scores/{docId} {
      allow get: if isTeacher() || isOwner(resource);
      allow list: if isTeacher() || request.auth != null;
      allow create, update: if isTeacher() || (request.auth != null
        && request.auth.uid == docId
        && request.resource.data.uid == request.auth.uid);
      allow delete: if isTeacher();
    }

    // AI help logs: students can create their own; teacher reads all
    match /interventions/{id} {
      allow read: if isTeacher();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    // Notices: students read active ones; teacher writes
    match /notices/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isTeacher();
    }

    // Read receipts: students create their own; teacher reads all
    match /notice_reads/{id} {
      allow read: if isTeacher() || request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    // System log (written server-side by the logEvent Cloud Function via Admin
    // SDK — bypasses rules). The teacher reads it for the Diagnostics report.
    match /logs/{id} {
      allow read: if isTeacher();
      // no client writes: only the logEvent function (Admin SDK) may write
      allow create, update, delete: if false;
    }

    // Daily log summaries (computed by rotateLogs)
    match /log_daily/{id} {
      allow read: if isTeacher();
      allow write: if false;
    }

    // Writing submissions: students create their own; teacher reads + grades all
    match /writings/{id} {
      allow read: if isTeacher() || request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Read-aloud recordings (metadata; the audio lives in Storage)
    match /readings/{id} {
      allow read: if isTeacher() || request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }
  }
}